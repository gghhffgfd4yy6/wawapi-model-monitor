// 复制为 wawapi_model_monitor.local.js 后填写本机密钥；该本地文件已被 Git 忽略。
module.exports = {
  // 单个 API Key 形式（与 apiKeys 数组二选一，数组优先）
  apiKey: '',
  // 多个 API Key 形式：并发用多个 Key 拉取/探测，任一 Key 成功即可用
  // apiKeys: [],
  // 可选：要探测可用性的模型列表（能“响应”才算可用）。
  // 留空数组/不填 = 不启用模型探测。
  probeModels: [],
  // 可选：两次探测的最小间隔（毫秒），默认 1 小时（3600000）。
  // 只有距上次成功响应超过该间隔才会再次探测。
  probeIntervalMs: 3600000,
  watchExact: [],
  watchPrefixes: [],
  intervalMs: 300000
}
